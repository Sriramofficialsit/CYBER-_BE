# Cyber Investigation Assistant — backend config. Copy to .env for local dev.
# On Render, set these in the dashboard (Environment), not in a file.

# USE_MEMORY_DB=true starts an in-process MongoDB (local dev only; the package is
# a devDependency). Leave it unset / false in production and provide MONGO_URI.
USE_MEMORY_DB=true
MONGO_URI=mongodb://localhost:27017/cyber_investigation_prototype
# Atlas example:
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/cyber_investigation_prototype?retryWrites=true&w=majority

NODE_ENV=development
PORT=5000

# Comma-separated CORS allowlist (your Netlify site URL). Leave empty when the
# client reaches the API through a Netlify proxy (same-origin).
CORS_ORIGIN=

JWT_SECRET=change-me

# Auto-seed synthetic cases on startup when the DB is empty.
SEED_ON_START=true

# Demo login (single "investigator" role for the prototype).
DEMO_USERNAME=investigator
DEMO_PASSWORD=investigator

# AI layer — Google Gemini. Empty (or a failing key) => deterministic local mock.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash
SIMILARITY_TOP_K=5
